KNOWLEDGE_INTELLIGENCE_AWS_REGION=ap-south-1
KNOWLEDGE_INTELLIGENCE_S3_BUCKET=
KNOWLEDGE_INTELLIGENCE_S3_PREFIX=raw/confluence/
KNOWLEDGE_INTELLIGENCE_MAX_DOCUMENT_SIZE_MB=50

KNOWLEDGE_INTELLIGENCE_OPENAI_API_KEY=
KNOWLEDGE_INTELLIGENCE_OPENAI_MODEL=gpt-5.6-terra
KNOWLEDGE_INTELLIGENCE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_INTELLIGENCE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_INTELLIGENCE_EMBEDDING_BATCH_SIZE=16

KNOWLEDGE_INTELLIGENCE_VISUAL_ANALYSIS_ENABLED=true
KNOWLEDGE_INTELLIGENCE_VISUAL_ANALYSIS_MODEL=
KNOWLEDGE_INTELLIGENCE_VISUAL_RENDER_DPI=144
KNOWLEDGE_INTELLIGENCE_VISUAL_MAX_PAGES_PER_DOCUMENT=10

KNOWLEDGE_INTELLIGENCE_VECTOR_BUCKET_NAME=
KNOWLEDGE_INTELLIGENCE_VECTOR_INDEX_NAME=platform-knowledge
KNOWLEDGE_INTELLIGENCE_VECTOR_TOP_K=5
KNOWLEDGE_INTELLIGENCE_AGENT_MAX_SEARCH_RESULTS=5
KNOWLEDGE_INTELLIGENCE_REGISTRY_DIRECTORY=registry/components

KNOWLEDGE_INTELLIGENCE_GITHUB_ENABLED=false
KNOWLEDGE_INTELLIGENCE_GITHUB_TOKEN=
KNOWLEDGE_INTELLIGENCE_GITHUB_API_URL=https://api.github.com

KNOWLEDGE_INTELLIGENCE_SLACK_ENABLED=false
KNOWLEDGE_INTELLIGENCE_SLACK_BOT_TOKEN=
KNOWLEDGE_INTELLIGENCE_SLACK_SIGNING_SECRET=
KNOWLEDGE_INTELLIGENCE_SLACK_MAX_MESSAGE_LENGTH=3500
KNOWLEDGE_INTELLIGENCE_SLACK_CONVERSATION_WINDOW=20
KNOWLEDGE_INTELLIGENCE_FEEDBACK_PREFIX=feedback/slack

# Progressive Slack delivery: the answer fills in as it is generated.
# The interval throttles chat.update to stay inside Slack rate limits.
KNOWLEDGE_INTELLIGENCE_SLACK_STREAMING_ENABLED=true
KNOWLEDGE_INTELLIGENCE_SLACK_STREAM_INTERVAL_SECONDS=1.0

# Persist each Slack thread so conversations survive an ECS task restart.
KNOWLEDGE_INTELLIGENCE_SESSION_PERSISTENCE_ENABLED=false
KNOWLEDGE_INTELLIGENCE_SESSION_PREFIX=sessions/slack

# Summarize older turns instead of dropping them off the sliding window.
KNOWLEDGE_INTELLIGENCE_CONVERSATION_SUMMARIZATION_ENABLED=false
KNOWLEDGE_INTELLIGENCE_CONVERSATION_SUMMARY_RATIO=0.3
KNOWLEDGE_INTELLIGENCE_CONVERSATION_PRESERVE_RECENT_MESSAGES=10

# Structured per-answer timing metrics (no question, answer, or user data).
KNOWLEDGE_INTELLIGENCE_METRICS_ENABLED=true

# Required only for POST /admin/reindex.
KNOWLEDGE_INTELLIGENCE_ADMIN_TOKEN=
